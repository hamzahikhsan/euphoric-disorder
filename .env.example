# ==============================================================================
# euphoric.disorder — Environment Variables Template
# ==============================================================================
# Salin file ini ke .env.local untuk local development:
#   cp .env.example .env.local
# Masukkan nilai yang sama ke Vercel: Project Settings -> Environment Variables
# ==============================================================================

# 1. Supabase API (Didapat dari: Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Domain Situs (Opsional: untuk metadata SEO & OpenGraph)
NEXT_PUBLIC_SITE_URL=https://euphoric-disorder-eight.vercel.app
